# ──────────────────────────────────────────────────────────────────────────────
# 复制本文件为 .env 并填写真实值
# ──────────────────────────────────────────────────────────────────────────────

# LLM 配置（OpenAI 兼容格式）
# 通义千问示例：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama 示例：OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4-flash

# 嵌入模型（首次运行自动从 HuggingFace 下载）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# 向量库持久化目录（容器内路径）
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION_NAME=enterprise_kb

# RAG 参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# 上传目录
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE=52428800   # 50 MB

# Agent 重试次数（0 = 不重试）
MAX_TOOL_RETRIES=2

# 服务器
HOST=0.0.0.0
PORT=8000

# 会话历史最大轮数
SESSION_MAX_HISTORY=20
